<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FastBuildStorage"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!--
      Release behaviour:
      - scan player-owned ships at the configured interval (5 seconds by default);
      - inspect every active order layer for TradePerform;
      - only handle deliveries to a PLAYER-owned build storage;
      - when the ship is within the configured radius (5 km by default), move only the ware in that trade deal;
      - move only complete trade deals; never make a partial remote delivery;
      - cancel only the handled TradePerform order; preserve the player's queue.

      Intentionally not handled:
      - NPC trading or payments;
      - queued (non-current) orders;
      - any delivery where the trade partner is not represented as class.buildstorage.
    -->

    <!-- Runtime settings. Simple Menu Options immediately invokes the callback
         with either its stored value or the declared default. These defaults
         also make the delivery loop safe before that API finishes loading. -->
    <cue name="Globals">
      <actions>
        <set_value name="$UnloadRadiusKm" exact="5"/>
        <set_value name="$ScanIntervalSeconds" exact="5"/>
        <!-- Zero means unlimited internally. The UI represents this as infinity. -->
        <set_value name="$MaxDeliveriesPerCycle" exact="0"/>
      </actions>
    </cue>

    <cue name="FBS_RegisterOptions" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Simple_Menu_Options.Reloaded"/>
      </conditions>
      <actions>
        <signal_cue_instantly
          cue="md.Simple_Menu_Options.Register_Option"
          param="table[
            $category = {20260815, 1},
            $id = 'panandafog_fbs_unload_radius_km',
            $name = {20260815, 2},
            $mouseover = {20260815, 3},
            $default = 5,
            $type = 'slidercell',
            $args = table[
              $min = 1,
              $max = 50,
              $minSelect = 1,
              $maxSelect = 50,
              $step = 1,
              $suffix = ' km'
            ],
            $callback = FBS_OnOptionChanged
          ]"/>

        <signal_cue_instantly
          cue="md.Simple_Menu_Options.Register_Option"
          param="table[
            $category = {20260815, 1},
            $id = 'panandafog_fbs_scan_interval_seconds',
            $name = {20260815, 4},
            $mouseover = {20260815, 5},
            $default = 5,
            $type = 'slidercell',
            $args = table[
              $min = 1,
              $max = 60,
              $minSelect = 1,
              $maxSelect = 60,
              $step = 1,
              $suffix = ' s'
            ],
            $callback = FBS_OnOptionChanged
          ]"/>

        <signal_cue_instantly
          cue="md.Simple_Menu_Options.Register_Option"
          param="table[
            $category = {20260815, 1},
            $id = 'panandafog_fbs_max_deliveries_per_cycle',
            $name = {20260815, 6},
            $mouseover = {20260815, 7},
            $default = 100,
            $type = 'slidercell',
            $args = table[
              $min = 1,
              $max = 100,
              $minSelect = 1,
              $maxSelect = 100,
              $step = 1,
              $useInfiniteValue = true,
              $infiniteValue = 100
            ],
            $callback = FBS_OnOptionChanged
          ]"/>
      </actions>
    </cue>

    <cue name="FBS_OnOptionChanged" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <do_if value="event.param.$id == 'panandafog_fbs_unload_radius_km'">
          <set_value name="Globals.$UnloadRadiusKm" exact="event.param.$value"/>
        </do_if>
        <do_elseif value="event.param.$id == 'panandafog_fbs_scan_interval_seconds'">
          <set_value name="Globals.$ScanIntervalSeconds" exact="event.param.$value"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'panandafog_fbs_max_deliveries_per_cycle'">
          <set_value name="Globals.$MaxDeliveriesPerCycle"
                     exact="if (event.param.$value ge 100) then 0 else event.param.$value"/>
        </do_elseif>

        <debug_to_file directory="'FastBuildStorage'"
                       name="'fbs'"
                       text="'[FBS] setting: id=%1, value=%2, radius-km=%3, interval-seconds=%4, max-per-cycle=%5'.[event.param.$id, event.param.$value, Globals.$UnloadRadiusKm, Globals.$ScanIntervalSeconds, Globals.$MaxDeliveriesPerCycle]"
                       output="true"
                       append="true"/>
      </actions>
    </cue>

    <cue name="FBS_Loop">
      <delay exact="Globals.$ScanIntervalSeconds * 1s"/>
      <actions>
        <find_ship_by_true_owner faction="faction.player"
                                 space="player.galaxy"
                                 name="$Ships"
                                 multiple="true"/>

        <set_value name="$CompletedThisCycle" exact="0"/>

        <!-- Heartbeat and active settings. Requires -scriptlogfiles. -->
        <debug_to_file directory="'FastBuildStorage'"
                       name="'fbs'"
                       text="'[FBS] scan: player-ships=%1, radius-km=%2, interval-seconds=%3, max-per-cycle=%4'.[$Ships.count, Globals.$UnloadRadiusKm, Globals.$ScanIntervalSeconds, Globals.$MaxDeliveriesPerCycle]"
                       output="true"
                       append="true"/>

        <do_all exact="$Ships.count" counter="$i">
          <do_if value="(Globals.$MaxDeliveriesPerCycle gt 0) and ($CompletedThisCycle ge Globals.$MaxDeliveriesPerCycle)">
            <break/>
          </do_if>

          <set_value name="$Ship" exact="$Ships.{$i}"/>

          <do_if value="$Ship.exists and ($Ship != player.occupiedship) and ($Ship.orders.count gt 0)">
            <!--
              Docking and movement can occupy the first order layer while the
              parent TradePerform holds the actual deal. Inspect the full active
              order stack so queued ships are found before they dock.
            -->
            <do_all exact="$Ship.orders.count" counter="$OrderIndex">
              <do_if value="(Globals.$MaxDeliveriesPerCycle gt 0) and ($CompletedThisCycle ge Globals.$MaxDeliveriesPerCycle)">
                <break/>
              </do_if>

              <set_value name="$Order" exact="$Ship.orders.{$OrderIndex}"/>

              <do_if value="$Order.exists and ($Order.id == 'TradePerform') and @$Order.$tradedeal.exists">
              <set_value name="$Deal" exact="$Order.$tradedeal"/>

              <!--
                Do not infer the ship's role from $Deal.seller. In vanilla trade
                data, seller can describe the source station rather than this ship.
                A build storage as the buyer/owner is the actual requirement here.
              -->
              <set_value name="$Target" exact="null"/>

              <do_if value="@$Deal.buyer.isclass.buildstorage">
                <set_value name="$Target" exact="$Deal.buyer"/>
              </do_if>
              <do_elseif value="@$Deal.owner.isclass.buildstorage">
                <set_value name="$Target" exact="$Deal.owner"/>
              </do_elseif>

              <!-- Never complete NPC trades: this mod does not reproduce payment. -->
              <do_if value="$Target and $Target.exists and $Target.isplayerowned">
                <debug_to_file directory="'FastBuildStorage'"
                               name="'fbs'"
                               text="'[FBS] candidate: ship=%1, target=%2, distance=%3, order-layer=%4'.[$Ship.knownname, $Target.knownname, $Ship.distanceto.{$Target}, $OrderIndex]"
                               output="true"
                               append="true"/>

                <!-- MD distance values are measured in metres. -->
                <do_if value="$Ship.distanceto.{$Target} lt (Globals.$UnloadRadiusKm * 1000)">
                  <!-- Record child layers without cancelling them. Their IDs are
                       needed to release only the dock queue, not player orders. -->
                  <do_all exact="($OrderIndex - 1)" counter="$ChildOrderIndex">
                    <set_value name="$ChildOrder" exact="$Ship.orders.{$ChildOrderIndex}"/>
                    <debug_to_file directory="'FastBuildStorage'"
                                   name="'fbs'"
                                   text="'[FBS] child-order: ship=%1, layer=%2, id=%3'.[$Ship.knownname, $ChildOrderIndex, $ChildOrder.id]"
                                   output="true"
                                   append="true"/>
                  </do_all>

                  <!-- A build storage owns its processor through its build module. -->
                  <set_value name="$BuildProcessor" exact="$Target.buildmodule.buildprocessor"/>
                  <set_value name="$Ware" exact="$Deal.ware"/>

                  <!--
                    Cargo and needed-sequence entries are keyed collections, not
                    reliably objects with an .exists property. Read their counts
                    directly; a zero count safely excludes a non-matching ware.
                  -->
                  <do_if value="$BuildProcessor and $Ware">
                    <set_value name="$OnShip" exact="$Ship.cargo.{$Ware}.count"/>
                    <set_value name="$Needed" exact="$BuildProcessor.neededsequenceresources.{$Ware}.count"/>
                    <set_value name="$DealAmount" exact="$Deal.amount"/>

                    <debug_to_file directory="'FastBuildStorage'"
                                   name="'fbs'"
                                   text="'[FBS] inspect: ship=%1, ware=%2, onship=%3, needed=%4, deal=%5'.[$Ship.knownname, $Ware.name, $OnShip, $Needed, $DealAmount]"
                                   output="true"
                                   append="true"/>

                    <!--
                      An incomplete deal cannot be safely completed by cancelling
                      TradePerform. Leave it to vanilla instead of stranding a
                      remainder of the contracted cargo on the ship.
                    -->
                    <do_if value="$DealAmount gt 0 and $OnShip ge $DealAmount and $Needed ge $DealAmount">
                      <debug_to_file directory="'FastBuildStorage'"
                                     name="'fbs'"
                                     text="'[FBS] commit: ship=%1, target=%2, ware=%3, amount=%4'.[$Ship.knownname, $Target.knownname, $Ware.name, $DealAmount]"
                                     output="true"
                                     append="true"/>

                      <remove_cargo object="$Ship" ware="$Ware" exact="$DealAmount"/>
                      <add_cargo object="$Target" ware="$Ware" exact="$DealAmount"/>
                      <set_value name="$CompletedThisCycle" operation="add"/>

                      <!--
                        Vanilla TradePerform creates a DockAndWait child while it
                        waits for a berth; that child can in turn have a DockAt
                        child. Cancelling the parent alone does not reliably stop
                        an already-running dock wait. Remove only dock children
                        that explicitly name THIS TradePerform as their caller.
                        This deliberately excludes independent/future orders in
                        the player's queue.
                      -->
                      <do_all exact="($OrderIndex - 1)" counter="$ChildOrderIndex">
                        <set_value name="$ChildOrder" exact="$Ship.orders.{$ChildOrderIndex}"/>
                        <do_if value="$ChildOrder.exists and ($ChildOrder.id == 'DockAndWait' or $ChildOrder.id == 'DockAt') and (@$ChildOrder.$destination == $Target) and (@$ChildOrder.$callerid == $Order)">
                          <debug_to_file directory="'FastBuildStorage'"
                                         name="'fbs'"
                                         text="'[FBS] releasing dock child: ship=%1, layer=%2, id=%3, parent-layer=%4'.[$Ship.knownname, $ChildOrderIndex, $ChildOrder.id, $OrderIndex]"
                                         output="true"
                                         append="true"/>
                          <cancel_order order="$ChildOrder"/>
                        </do_if>
                      </do_all>

                      <!-- The exact trade parent follows its dock children. -->
                      <cancel_order order="$Order"/>

                      <debug_text text="'[FBS] Remote unload: %1 -> %2, %3 x %4'.[$Ship.knownname, $Target.knownname, $DealAmount, $Ware.name]"
                                  chance="100"/>
                      <debug_to_file directory="'FastBuildStorage'"
                                     name="'fbs'"
                                     text="'[FBS] completed: ship=%1, ware=%2, amount=%3, cancelled-trade-layer=%4'.[$Ship.knownname, $Ware.name, $DealAmount, $OrderIndex]"
                                     output="true"
                                     append="true"/>
                    </do_if>
                    <do_else>
                      <debug_to_file directory="'FastBuildStorage'"
                                     name="'fbs'"
                                     text="'[FBS] skipped incomplete deal: ship=%1, ware=%2, onship=%3, needed=%4, deal=%5'.[$Ship.knownname, $Ware.name, $OnShip, $Needed, $DealAmount]"
                                     output="true"
                                     append="true"/>
                    </do_else>
                  </do_if>
                </do_if>
              </do_if>
              </do_if>
            </do_all>
          </do_if>
        </do_all>

        <debug_to_file directory="'FastBuildStorage'"
                       name="'fbs'"
                       text="'[FBS] scan completed: deliveries=%1, limit=%2'.[$CompletedThisCycle, Globals.$MaxDeliveriesPerCycle]"
                       output="true"
                       append="true"/>

        <!-- Periodic loop. reset_cue takes effect after the current actions finish. -->
        <reset_cue cue="this"/>
      </actions>
    </cue>
  </cues>
</mdscript>
