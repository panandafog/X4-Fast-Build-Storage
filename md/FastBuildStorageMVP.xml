<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FastBuildStorageMVP"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!--
      MVP behaviour:
      - every 5 seconds scan player-owned ships;
      - inspect every active order layer for TradePerform;
      - only handle deliveries to a PLAYER-owned build storage;
      - when the ship is within 5 km, move only the ware in that trade deal;
      - move only complete trade deals; never make a partial remote delivery;
      - cancel only the handled TradePerform order; preserve the player's queue.

      Intentionally NOT handled in v0.2:
      - NPC trading or payments;
      - queued (non-current) orders;
      - UI/settings;
      - any delivery where the trade partner is not represented as class.buildstorage.
    -->
    <cue name="FBS_Loop">
      <delay exact="5s"/>
      <actions>
        <find_ship_by_true_owner faction="faction.player"
                                 space="player.galaxy"
                                 name="$Ships"
                                 multiple="true"/>

        <!-- Test-only heartbeat. Requires -scriptlogfiles; remove or disable after validation. -->
        <debug_to_file directory="'FastBuildStorageMVP'"
                       name="'fbs'"
                       text="'[FBS] scan: player ships=%1'.[$Ships.count]"
                       output="true"
                       append="true"/>

        <do_all exact="$Ships.count" counter="$i">
          <set_value name="$Ship" exact="$Ships.{$i}"/>

          <do_if value="$Ship.exists and ($Ship != player.occupiedship) and ($Ship.orders.count gt 0)">
            <!--
              Docking and movement can occupy the first order layer while the
              parent TradePerform holds the actual deal. Inspect the full active
              order stack so queued ships are found before they dock.
            -->
            <do_all exact="$Ship.orders.count" counter="$OrderIndex">
              <set_value name="$Order" exact="$Ship.orders.{$OrderIndex}"/>

              <do_if value="$Order.exists and ($Order.id == 'TradePerform') and @$Order.$tradedeal.exists">
              <set_value name="$Deal" exact="$Order.$tradedeal"/>

              <!--
                Do not infer the ship's role from $Deal.seller. In vanilla trade
                data, seller can describe the source station rather than this ship.
                A build storage as the buyer/owner is the actual requirement here.
              -->
              <set_value name="$Target" exact="null"/>

              <do_if value="@$Deal.buyer.isclass.buildstorage">
                <set_value name="$Target" exact="$Deal.buyer"/>
              </do_if>
              <do_elseif value="@$Deal.owner.isclass.buildstorage">
                <set_value name="$Target" exact="$Deal.owner"/>
              </do_elseif>

              <!-- Never complete NPC trades: this MVP does not reproduce payment. -->
              <do_if value="$Target and $Target.exists and $Target.isplayerowned">
                <debug_to_file directory="'FastBuildStorageMVP'"
                               name="'fbs'"
                               text="'[FBS] candidate: ship=%1, target=%2, distance=%3, order-layer=%4'.[$Ship.knownname, $Target.knownname, $Ship.distanceto.{$Target}, $OrderIndex]"
                               output="true"
                               append="true"/>

                <do_if value="$Ship.distanceto.{$Target} lt 5km">
                  <!-- Record child layers without cancelling them. Their IDs are
                       needed to release only the dock queue, not player orders. -->
                  <do_all exact="($OrderIndex - 1)" counter="$ChildOrderIndex">
                    <set_value name="$ChildOrder" exact="$Ship.orders.{$ChildOrderIndex}"/>
                    <debug_to_file directory="'FastBuildStorageMVP'"
                                   name="'fbs'"
                                   text="'[FBS] child-order: ship=%1, layer=%2, id=%3'.[$Ship.knownname, $ChildOrderIndex, $ChildOrder.id]"
                                   output="true"
                                   append="true"/>
                  </do_all>

                  <!-- A build storage owns its processor through its build module. -->
                  <set_value name="$BuildProcessor" exact="$Target.buildmodule.buildprocessor"/>
                  <set_value name="$Ware" exact="$Deal.ware"/>

                  <!--
                    Cargo and needed-sequence entries are keyed collections, not
                    reliably objects with an .exists property. Read their counts
                    directly; a zero count safely excludes a non-matching ware.
                  -->
                  <do_if value="$BuildProcessor and $Ware">
                    <set_value name="$OnShip" exact="$Ship.cargo.{$Ware}.count"/>
                    <set_value name="$Needed" exact="$BuildProcessor.neededsequenceresources.{$Ware}.count"/>
                    <set_value name="$DealAmount" exact="$Deal.amount"/>

                    <debug_to_file directory="'FastBuildStorageMVP'"
                                   name="'fbs'"
                                   text="'[FBS] inspect: ship=%1, ware=%2, onship=%3, needed=%4, deal=%5'.[$Ship.knownname, $Ware.name, $OnShip, $Needed, $DealAmount]"
                                   output="true"
                                   append="true"/>

                    <!--
                      An incomplete deal cannot be safely completed by cancelling
                      TradePerform. Leave it to vanilla instead of stranding a
                      remainder of the contracted cargo on the ship.
                    -->
                    <do_if value="$DealAmount gt 0 and $OnShip ge $DealAmount and $Needed ge $DealAmount">
                      <debug_to_file directory="'FastBuildStorageMVP'"
                                     name="'fbs'"
                                     text="'[FBS] commit: ship=%1, target=%2, ware=%3, amount=%4'.[$Ship.knownname, $Target.knownname, $Ware.name, $DealAmount]"
                                     output="true"
                                     append="true"/>

                      <remove_cargo object="$Ship" ware="$Ware" exact="$DealAmount"/>
                      <add_cargo object="$Target" ware="$Ware" exact="$DealAmount"/>

                      <!--
                        Do not cancel the whole order stack: it can include the
                        player's queued future instructions. A safe release of the
                        dock child requires identifying its exact vanilla order ID.
                      -->
                      <cancel_order order="$Order"/>

                      <debug_text text="'[FBS] Remote unload: %1 -> %2, %3 x %4'.[$Ship.knownname, $Target.knownname, $DealAmount, $Ware.name]"
                                  chance="100"/>
                      <debug_to_file directory="'FastBuildStorageMVP'"
                                     name="'fbs'"
                                     text="'[FBS] completed: ship=%1, ware=%2, amount=%3, cancelled-order-layer=%4'.[$Ship.knownname, $Ware.name, $DealAmount, $OrderIndex]"
                                     output="true"
                                     append="true"/>
                    </do_if>
                    <do_else>
                      <debug_to_file directory="'FastBuildStorageMVP'"
                                     name="'fbs'"
                                     text="'[FBS] skipped incomplete deal: ship=%1, ware=%2, onship=%3, needed=%4, deal=%5'.[$Ship.knownname, $Ware.name, $OnShip, $Needed, $DealAmount]"
                                     output="true"
                                     append="true"/>
                    </do_else>
                  </do_if>
                </do_if>
              </do_if>
              </do_if>
            </do_all>
          </do_if>
        </do_all>

        <!-- Periodic loop. reset_cue takes effect after the current actions finish. -->
        <reset_cue cue="this"/>
      </actions>
    </cue>
  </cues>
</mdscript>
